{
  "name": "level-3-pixijs-slot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:typecheck": "tsc --project server/tsconfig.json",
    "db:check": "node --env-file=server/.env --import tsx server/checkDatabase.ts",
    "db:session-check": "node --env-file=server/.env --import tsx server/checkSessionStorage.ts",
    "check": "npm run server:typecheck && npm run test && npm run build",
    "db:spin-check": "node --env-file=server/.env --import tsx server/checkStoredSpin.ts",
    "db:idempotency-check": "node --env-file=server/.env --import tsx server/checkSpinIdempotency.ts",
    "db:chest-check": "node --env-file=server/.env --import tsx server/checkStoredChest.ts"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "pixi.js": "^8.20.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
